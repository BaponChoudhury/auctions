# EPC: the old API (epc.opendatacommunities.org) was RETIRED on 30 May 2026 and
# these credentials no longer work anywhere. The replacement service requires
# GOV.UK One Login and serves bulk files only:
#   https://get-energy-performance-data.communities.gov.uk/
# Download the domestic certificates file, unzip into data/epc/, run src/epc_load.py.
# These two are kept only so an old .env does not break; nothing reads them now.
EPC_EMAIL=
EPC_KEY=

# Supabase Postgres connection string (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# UK HPI area to time-adjust comps against. K02000001 = United Kingdom.
# The hpi table is keyed by (area_code, month), so this must be set to one area.
HPI_AREA_CODE=K02000001
